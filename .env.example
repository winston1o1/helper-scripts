# Example configuration for helper_scripts.
# Copy this file to `.env` and replace the placeholder values.
#
# .env files use SECTION__KEY names: the config section becomes an uppercase
# prefix followed by a double underscore. See readme.md for full documentation.

# --- PostgreSQL database (section: db_server) ---
DB_SERVER__HOST=localhost
DB_SERVER__PORT=5432
DB_SERVER__DBNAME=my_database
DB_SERVER__USER=postgres
DB_SERVER__PASSWORD=your_password

# --- Primary email server (section: email_server) ---
EMAIL_SERVER__SMTP_SERVER=smtp.example.com
EMAIL_SERVER__PORT=587
EMAIL_SERVER__SENDER_EMAIL=you@example.com
EMAIL_SERVER__SENDER_USERNAME=your_username
EMAIL_SERVER__PASSWORD=your_password
EMAIL_SERVER__PLATFORM=example

# --- Secondary email server (section: secondary_server) ---
SECONDARY_SERVER__SMTP_SERVER=smtp.backup.com
SECONDARY_SERVER__PORT=587
SECONDARY_SERVER__SENDER_EMAIL=backup@example.com
SECONDARY_SERVER__SENDER_USERNAME=backup_username
SECONDARY_SERVER__PASSWORD=backup_password
SECONDARY_SERVER__PLATFORM=backup
